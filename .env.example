# ШАБЛОН .env — скопіюй у .env та заповни секрети. РЕАЛЬНИЙ .env у .gitignore, НЕ комітити!
#   cp .env.example .env  &&  nano .env
#
# Цей .env читають: shipper (через env_file у docker-compose) та host-колектори (python-dotenv).

# --- Telegram (для tg.py / migrate_history.py) ---
API_ID=000000
API_HASH=your_telegram_api_hash

# --- MongoDB ---
# Обліковий запис застосунку. Створюється на сервері разом з keyFile (див. DEPLOY_SERVER.md,
# розділ «Автентифікація Mongo»). Пароль — hex, щоб не потребував percent-encoding у URI.
# УВАГА: при ротації пароля міняти в ТРЬОХ місцях нижче (user/password + обидва URI).
MONGO_APP_USER=onyx_app
MONGO_APP_PASSWORD=REPLACE_ME
# Адреса для SHIPPER (всередині docker-мережі — за іменем сервісу, replica set обовʼязковий):
MONGO_URI=mongodb://onyx_app:REPLACE_ME@mongo:27017/?replicaSet=rs0&authSource=admin
# Адреса для HOST-КОЛЕКТОРІВ (tg.py, migrate_history.py, collectors/*) і для UI — через
# прокинутий порт. НА СЕРВЕРІ це 27018 (27017 зайнятий чужим системним mongod!).
COLLECTOR_MONGO_URI=mongodb://onyx_app:REPLACE_ME@127.0.0.1:27018/?directConnection=true&authSource=admin
MONGO_DB=threat_intel
MONGO_COLLECTION=raw_events

# --- Ollama: ТІЛЬКИ ембеддинги (nomic-embed-text, CPU) ---
# Для shipper (docker) — за іменем сервісу:
OLLAMA_URL=http://ollama:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- LLM (Hermes 3) через OpenAI-сумісний API ---
# Сервер (без GPU): хмарний OpenRouter. Безкоштовний тариф 405B; коли зʼявиться бюджет —
# заміни на платний nousresearch/hermes-3-llama-3.1-70b (стабільніше, без rate-limit).
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=sk-or-REPLACE_ME
LLM_MODEL=nousresearch/hermes-3-llama-3.1-405b:free
# Шиппер відмовляється слати Bearer-ключ по відкритому HTTP на неloopback-хост —
# щоб ключ OpenRouter не поїхав відкритим текстом у бік стороннього ендпойнта.
# Для хмарного (HTTPS) режиму вище нічого вмикати НЕ треба.
#
# Локально через свою Ollama (без хмари) — розкоментуй увесь блок разом:
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=hermes3
#   LLM_API_KEY=ollama
#   ALLOW_PLAINTEXT_LLM_KEY=true    # ← лише для docker-бриджа, не для зовнішнього хоста

# --- Заземлення міток CVE/MITRE (shipper/grounding.py) ---
# Модель сама вирішує, які CVE/техніки навісити, а верифікація NVD/MITRE
# підтверджує лише ІСНУВАННЯ ідентифікатора, не його доречність. Тому перед
# верифікацією стоїть гейт: мітка має бути ЗАЗЕМЛЕНА в тексті документа.
#   literal — лише дослівна згадка ідентифікатора в тексті (ДЕФОЛТ, можна не задавати);
#   quoted  — плюс мітки, підкріплені цитатою, яка справді є в документі;
#   off     — стара поведінка, приймати все (аварійний важіль; саме вона дала
#             375 вигаданих T1190 із 380 міток на бойовому корпусі).
# Чому дефолт найсуворіший: A/B на бойовому корпусі (hermes3:8b, 07.09.2026)
# показав, що з вимогою цитувати модель перестає штампувати T1190, але починає
# навішувати ІНШІ техніки зі справжніми, але не по темі цитатами. Тобто "quoted"
# міняє форму вигадки, а не прибирає її.
# GROUNDING_MODE=literal

# --- Додаткові LLM-бекенди для агентів ONYX (llm_backends.py) ---
# Зараз ("default" вище) усі агенти можуть ходити в ОДНУ модель — незалежність
# багатоагентного аналізу зводиться лише до різних системних промптів. Якщо
# задати ключ(і) нижче, у кожного агента в UI зʼявиться селектор LLM-бекенду —
# тоді різні агенти реально йдуть у РІЗНІ моделі різних провайдерів (а не одну
# й ту саму модель під різними інструкціями), і оцінки стають дійсно незалежними.
#
# Groq (швидкий інференс, окремий провайдер від OpenRouter):
# GROQ_API_KEY=gsk-REPLACE_ME
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b        # каталог Groq змінюється — звіряй за /v1/models
#
# Другий, ОКРЕМИЙ ключ/модель OpenRouter (напр. інша модель від "default" вище,
# щоб мати ще один незалежний бекенд без нового провайдера):
# OPENROUTER_API_KEY=sk-or-REPLACE_ME
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=deepseek/deepseek-chat-v3-0324:free
#
# Локальна Ollama з окремою LLM-моделлю (ключ не потрібен):
# OLLAMA_LLM_URL=http://127.0.0.1:11434/v1
# OLLAMA_LLM_MODEL=hermes3

# --- Manticore (HTTP endpoint для shipper, всередині docker) ---
MANTICORE_URL=http://manticore:9308
MANTICORE_TABLE=events_enriched

# --- NVD (опціонально, без ключа ліміт 5 req/30s) ---
NVD_API_KEY=

# --- Дедуплікація / батчинг ---
DEDUP_SIMILARITY_THRESHOLD=0.92
DEDUP_WINDOW_SIZE=1000
BATCH_SIZE=50
BATCH_TIMEOUT_SECONDS=2.0

# --- Надійність шиппера (дефолти нижче = поточна поведінка, можна не задавати) ---
# Ексклюзивна оренда конвеєра: другий інстанс не запуститься, поки не спливе
# STALE (страховка від подвійної обробки; після краху лізу перехоплюють за 120с).
# SHIPPER_LEASE_SECONDS=60
# SHIPPER_STALE_SECONDS=120
# Ретраї Manticore + куди складати те, що так і не записалось (dead letters):
# MANTICORE_MAX_RETRIES=3
# DEAD_LETTER_COLLECTION=shipper_dead_letters
# Черга до сінка та паралельність збагачення:
# SINK_QUEUE_MAXSIZE=200
# PIPELINE_CONCURRENCY=32
# PIPELINE_MAX_RETRIES=2
# Loopback-ендпойнт готовності всередині контейнера (GET / → JSON + 200/503):
# SHIPPER_HEALTH_PORT=9100
# Обрізання аномально великих подій (захист памʼяті):
# SHIPPER_MAX_EVENT_TEXT_CHARS=1000000
